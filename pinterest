#!/bin/bash

# Renk kodları
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # Renk sıfırlama

# Log dosyası
LOG_FILE="bug_bounty_scan.log"
echo "[$(date)] Script başlatıldı" > $LOG_FILE

# Çalışma dizini
WORK_DIR="/data/data/com.termux/files/home/bug_bounty_work"
OUTPUT_DIR="$WORK_DIR/bug_bounty_$(date +%F_%H-%M-%S)"

# Hata kontrolü fonksiyonu
check_error() {
    if [ $? -ne 0 ]; then
        echo -e "${RED}Hata: $1${NC}" | tee -a $LOG_FILE
        exit 1
    fi
}

# Dosya kontrolü fonksiyonu
check_file() {
    local file=$1
    if [ ! -s "$file" ]; then
        echo -e "${YELLOW}[*] Uyarı: $file boş veya mevcut değil, oluşturuluyor...${NC}" | tee -a $LOG_FILE
        touch "$file"
    fi
}

# İlerleme çubuğu fonksiyonu
progress_bar() {
    local progress=$1
    local total=$2
    local width=50
    local percent=$((progress * 100 / total))
    local filled=$((width * progress / total))
    local empty=$((width - filled))
    printf "\r${CYAN}[%-${width}s] %d%%${NC}" "$(printf '#%.0s' $(seq 1 $filled))" "$percent"
}

# Araç kontrolü ve kurulum fonksiyonu
check_and_install_tools() {
    echo -e "${YELLOW}[*] Gerekli araçlar kontrol ediliyor...${NC}" | tee -a $LOG_FILE
    
    # Gerekli bağımlılıklar
    echo -e "${YELLOW}[*] Bağımlılıklar kontrol ediliyor...${NC}" | tee -a $LOG_FILE
    pkg install golang git python figlet chromium -y &> /dev/null
    check_error "Bağımlılıklar kurulamadı"

    # Python tabanlı araçlar (arjun)
    if ! command -v arjun &> /dev/null; then
        echo -e "${YELLOW}[*] Arjun bulunamadı, kuruluyor...${NC}" | tee -a $LOG_FILE
        pip install arjun &> /dev/null
        check_error "Arjun kurulumu başarısız"
    fi

    # Go tabanlı araçlar
    go_tools=("subfinder" "katana" "httpx" "nuclei" "waybackurls" "gf" "dalfox" "anew" "getjs" "gau" "hakrawler")
    total_tools=${#go_tools[@]}
    current_tool=0
    for tool in "${go_tools[@]}"; do
        ((current_tool++))
        progress_bar $current_tool $total_tools
        if ! command -v $tool &> /dev/null; then
            echo -e "\n${YELLOW}[*] $tool bulunamadı, kuruluyor...${NC}" | tee -a $LOG_FILE
            case $tool in
                subfinder)
                    go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest
                    ;;
                katana)
                    go install -v github.com/projectdiscovery/katana/cmd/katana@latest
                    ;;
                httpx)
                    go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest
                    ;;
                nuclei)
                    go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest
                    ;;
                waybackurls)
                    go install github.com/tomnomnom/waybackurls@latest
                    ;;
                gf)
                    go install github.com/tomnomnom/gf@latest
                    ;;
                dalfox)
                    go install github.com/hahwul/dalfox/v2@latest
                    ;;
                anew)
                    go install github.com/tomnomnom/anew@latest
                    ;;
                getjs)
                    go install github.com/003random/getJS@latest
                    ;;
                gau)
                    go install github.com/lc/gau/v2/cmd/gau@latest
                    ;;
                hakrawler)
                    go install github.com/hakluke/hakrawler@latest
                    ;;
            esac
            check_error "$tool kurulumu başarısız"
            mv ~/go/bin/$tool /data/data/com.termux/files/usr/bin/
            check_error "$tool taşınırken hata"
        fi
    done
    echo -e "\n${GREEN}[+] Tüm araçlar kuruldu${NC}" | tee -a $LOG_FILE

    # GF desenleri
    if [ ! -d ~/.gf ]; then
        echo -e "${YELLOW}[*] GF desenleri indiriliyor...${NC}" | tee -a $LOG_FILE
        git clone https://github.com/1ndianl33t/Gf-Patterns $WORK_DIR/Gf-Patterns
        mkdir -p ~/.gf
        cp $WORK_DIR/Gf-Patterns/*.json ~/.gf/
        check_error "GF desenleri kurulamadı"
        rm -rf $WORK_DIR/Gf-Patterns
    fi

    # Nuclei şablonları
    if [ ! -d ~/nuclei-templates ]; then
        echo -e "${YELLOW}[*] Nuclei şablonları indiriliyor...${NC}" | tee -a $LOG_FILE
        git clone https://github.com/projectdiscovery/nuclei-templates ~/nuclei-templates
        check_error "Nuclei şablonları indirilemedi"
    else
        echo -e "${YELLOW}[*] Nuclei şablonları güncelleniyor...${NC}" | tee -a $LOG_FILE
        cd ~/nuclei-templates && git pull &> /dev/null
        check_error "Nuclei şablonları güncellenemedi"
    fi

    # Özel kelime listesi (API yolları için)
    if [ ! -f $WORK_DIR/api_wordlist.txt ]; then
        echo -e "${YELLOW}[*] API kelime listesi indiriliyor...${NC}" | tee -a $LOG_FILE
        wget -q https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content/api/words.txt -O $WORK_DIR/api_wordlist.txt
        check_error "API kelime listesi indirilemedi"
    fi

    echo -e "${GREEN}[+] Tüm araçlar ve eklentiler hazır!${NC}" | tee -a $LOG_FILE
}

# JSON çıktı fonksiyonu
generate_json_output() {
    local output_dir=$1
    local json_file="$output_dir/results.json"
    echo "{" > $json_file
    echo "  \"domain\": \"$DOMAIN\"," >> $json_file
    echo "  \"timestamp\": \"$(date)\"," >> $json_file
    echo "  \"api_endpoints\": [" >> $json_file
    if [ -s $output_dir/verified_api_results.txt ]; then
        while IFS= read -r line; do
            url=$(echo "$line" | awk '{print $1}')
            echo "    \"$url\"," >> $json_file
        done < $output_dir/verified_api_results.txt
        sed -i '$ s/,$//' $json_file
    fi
    echo "  ]," >> $json_file
    echo "  \"sensitive_data\": [" >> $json_file
    if [ -s $output_dir/api_keys.txt ]; then
        awk '{print "    \"" $0 "\","}' $output_dir/api_keys.txt | sed '$ s/,$//' >> $json_file
    fi
    echo "  ]," >> $json_file
    echo "  \"js_endpoints\": [" >> $json_file
    if [ -s $output_dir/js_endpoints.txt ]; then
        awk '{print "    \"" $0 "\","}' $output_dir/js_endpoints.txt | sed '$ s/,$//' >> $json_file
    fi
    echo "  ]," >> $json_file
    echo "  \"hidden_parameters\": [" >> $json_file
    if [ -s $output_dir/arjun_results.txt ]; then
        awk '{print "    \"" $0 "\","}' $output_dir/arjun_results.txt | sed '$ s/,$//' >> $json_file
    fi
    echo "  ]," >> $json_file
    echo "  \"vulnerabilities\": [" >> $json_file
    if [ -s $output_dir/nuclei_results.txt ]; then
        awk '{print "    \"" $0 "\","}' $output_dir/nuclei_results.txt | sed '$ s/,$//' >> $json_file
    fi
    echo "  ]," >> $json_file
    echo "  \"xss_vulnerabilities\": [" >> $json_file
    if [ -s $output_dir/dalfox_results.txt ]; then
        awk '{print "    \"" $0 "\","}' $output_dir/dalfox_results.txt | sed '$ s/,$//' >> $json_file
    fi
    echo "  ]" >> $json_file
    echo "}" >> $json_file
}

# Çalışma dizini oluştur
mkdir -p $WORK_DIR
check_error "Çalışma dizini oluşturulamadı"

# Banner
if command -v figlet &> /dev/null; then
    echo -e "${GREEN}"
    figlet -f standard "Bug Bounty"
    echo -e "${NC}"
else
    echo -e "${BLUE}=======================================${NC}"
    echo -e "${GREEN} Termux Bug Bounty Tarama Scripti${NC}"
    echo -e "${BLUE}=======================================${NC}"
fi
echo -e "${YELLOW}Yazar: losmanchos${NC}"
echo -e "${RED}Uyarı: Yalnızca izinli sistemlerde kullanın!${NC}\n"

# Hedef domaini al
read -p $'\e[34m[*] Hedef domaini girin (örn. example.com): \e[0m' DOMAIN
if [ -z "$DOMAIN" ]; then
    echo -e "${RED}Hata: Domain girilmedi!${NC}" | tee -a $LOG_FILE
    exit 1
fi
echo -e "${GREEN}[+] Hedef: $DOMAIN${NC}\n" | tee -a $LOG_FILE

# Araçları kontrol et ve kur
check_and_install_tools

# Çıktı dosyaları için dizin oluştur
mkdir -p $OUTPUT_DIR
check_error "Çıktı dizini oluşturulamadı"

# Adım 1: Subdomain tarama (API'siz)
echo -e "${YELLOW}[*] Subdomain taraması başlatılıyor...${NC}" | tee -a $LOG_FILE
subfinder -d $DOMAIN -o $OUTPUT_DIR/subdomains.txt -silent -nW
check_error "Subdomain taraması başarısız"
check_file $OUTPUT_DIR/subdomains.txt
SUBDOMAIN_COUNT=$(wc -l < $OUTPUT_DIR/subdomains.txt)
echo -e "${GREEN}[+] $SUBDOMAIN_COUNT subdomain bulundu${NC}\n" | tee -a $LOG_FILE

# Adım 2: Katana ile API ve URL keşfi
echo -e "${YELLOW}[*] Katana ile API ve URL taraması başlatılıyor...${NC}" | tee -a $LOG_FILE
katana -u $OUTPUT_DIR/subdomains.txt -o $OUTPUT_DIR/katana_results.txt -c 50 -d 5 -f url -ef css,js,png,jpg,jpeg,gif -silent
check_error "Katana taraması başarısız"
check_file $OUTPUT_DIR/katana_results.txt

# Adım 3: Waybackurls ve Gau ile geçmiş URL’ler
echo -e "${YELLOW}[*] Geçmiş URL’ler taranıyor (Waybackurls ve Gau)...${NC}" | tee -a $LOG_FILE
waybackurls $DOMAIN | anew $OUTPUT_DIR/wayback_urls.txt
check_error "Waybackurls taraması başarısız"
gau $DOMAIN --subs | anew $OUTPUT_DIR/gau_urls.txt
check_error "Gau taraması başarısız"
check_file $OUTPUT_DIR/wayback_urls.txt
check_file $OUTPUT_DIR/gau_urls.txt

# Adım 4: Hakrawler ile web tarama
echo -e "${YELLOW}[*] Hakrawler ile web taraması başlatılıyor...${NC}" | tee -a $LOG_FILE
cat $OUTPUT_DIR/subdomains.txt | hakrawler -depth 3 -plain > $OUTPUT_DIR/hakrawler_results.txt
check_error "Hakrawler taraması başarısız"
check_file $OUTPUT_DIR/hakrawler_results.txt

# API uç noktalarını birleştir ve filtrele
cat $OUTPUT_DIR/katana_results.txt $OUTPUT_DIR/wayback_urls.txt $OUTPUT_DIR/gau_urls.txt $OUTPUT_DIR/hakrawler_results.txt | grep -E "/api|/v1|/graphql|/swagger|/docs" | sort -u | anew $OUTPUT_DIR/api_urls.txt
check_file $OUTPUT_DIR/api_urls.txt
API_COUNT=$(wc -l < $OUTPUT_DIR/api_urls.txt)
echo -e "${GREEN}[+] $API_COUNT potansiyel API uç noktası bulundu${NC}\n" | tee -a $LOG_FILE

# Adım 5: GetJS ile JavaScript dosyası analizi
echo -e "${YELLOW}[*] JavaScript dosyaları analiz ediliyor...${NC}" | tee -a $LOG_FILE
cat $OUTPUT_DIR/katana_results.txt $OUTPUT_DIR/wayback_urls.txt $OUTPUT_DIR/gau_urls.txt | grep "\.js$" | getJS --
